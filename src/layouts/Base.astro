---
/**
 * Casca HTML comum às quatro páginas. Só infraestrutura: metadados, favicon,
 * classes de movimento e o reset mínimo. Cada demo traz os próprios tokens,
 * fontes e componentes no seu CSS.
 */
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  /** Nome curto usado em og:site_name. */
  siteName: string;
  /** Caminho do favicon em /public. */
  favicon: string;
  /** Imagem Open Graph em /public (1200x630). */
  ogImage: string;
  themeColor: string;
  /** Identificador da demo; vira data-demo no <html>. */
  demo: string;
  lang?: string;
}

const { title, description, siteName, favicon, ogImage, themeColor, demo, lang = 'pt-BR' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'http://127.0.0.1:4332');
const ogUrl = new URL(ogImage, canonical);
---

<!doctype html>
<html lang={lang} data-demo={demo}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Decide o modo de movimento antes do primeiro paint (evita flash de conteúdo
      // no estado final antes das animações). Se o script da página não subir em
      // 6 s, a página volta ao estado estático e legível.
      (function () {
        var d = document.documentElement;
        var rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        d.classList.add('js', rm ? 'rm' : 'motion');
        window.setTimeout(function () {
          if (!window.__demoReady) {
            d.classList.remove('motion');
            d.classList.add('rm', 'motion-failed');
          }
        }, 6000);
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
